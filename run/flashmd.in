units metal

atom_style atomic

read_data water-128.lmp

comm_modify cutoff 20.0

mass 1 1.008
mass 2 15.999

# pair_style metatomic mlip.pt device cuda non_conservative off
# pair_coeff * * 1 8

run_style verlet

timestep 0.008

thermo 1

velocity all create 300 87287 mom no rot no dist gaussian

# fix 1 all nve
fix 1 all metatomic flashmd.pt types 1 8 energy doesnt-exist.pt device cuda rescale_energy on
# fix 2 all langevin 300.0 300.0 0.1 12345
# fix 3 all press/langevin iso 1.0 1.0 10.0 temp 300 300 67890

run 1000
